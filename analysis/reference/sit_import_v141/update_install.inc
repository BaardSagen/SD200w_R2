#include <wincrypt.h>
#ifndef CALG_SHA_256
#define CALG_SHA_256 0x800c
#endif
static std::wstring updateEnv(const wchar_t*name){wchar_t value[32768];DWORD n=GetEnvironmentVariableW(name,value,32768);if(!n||n>=32768)throw std::runtime_error("Start the single SAIV IT EXE to install an update.");return std::wstring(value,n);}
static std::wstring updateQuote(const std::wstring&s){if(s.find(L'"')!=std::wstring::npos)throw std::runtime_error("Invalid update path");return L"\""+s+L"\"";}
static std::string updateHash(const std::string&data){HCRYPTPROV p=0;HCRYPTHASH h=0;if(!CryptAcquireContextW(&p,0,0,PROV_RSA_AES,CRYPT_VERIFYCONTEXT))throw std::runtime_error("Cannot verify the download checksum");if(!CryptCreateHash(p,CALG_SHA_256,0,0,&h)){CryptReleaseContext(p,0);throw std::runtime_error("Cannot verify the download checksum");}BYTE digest[32];DWORD n=32;bool ok=CryptHashData(h,reinterpret_cast<BYTE*>(const_cast<char*>(data.data())),DWORD(data.size()),0)&&CryptGetHashParam(h,HP_HASHVAL,digest,&n,0);CryptDestroyHash(h);CryptReleaseContext(p,0);if(!ok)throw std::runtime_error("Cannot verify the download checksum");std::string s;for(BYTE b:digest){s+="0123456789abcdef"[b>>4];s+="0123456789abcdef"[b&15];}return s;}
struct UpdatePackage {std::wstring path;std::string oldHash;};
static UpdatePackage updateDownload(const situpdate::Manifest&m){if(m.sha256.size()!=64)throw std::runtime_error("The server must supply a SHA256 checksum before automatic installation.");auto target=updateEnv(L"SIT_LAUNCHER_PATH"),helper=updateEnv(L"SIT_UPDATE_HELPER");UpdatePackage package;package.oldHash=updateHash(readFile(target));auto data=updateFetch(m.download,100*1024*1024);if(updateHash(data)!=sitsettings::lower(m.sha256))throw std::runtime_error("Download checksum mismatch. Your current program has not been changed.");auto folder=helper.substr(0,helper.find_last_of(L'\\'))+L"\\Update-"+wide(std::to_string(GetCurrentProcessId()))+L"-"+wide(std::to_string(GetTickCount()));if(!CreateDirectoryW(folder.c_str(),0))throw std::runtime_error("Cannot prepare the downloaded update folder");package.path=folder+L"\\release.zip";HANDLE file=CreateFileW(package.path.c_str(),GENERIC_WRITE,0,0,CREATE_NEW,FILE_ATTRIBUTE_NORMAL,0);if(file==INVALID_HANDLE_VALUE)throw std::runtime_error("Cannot save the downloaded update");DWORD wrote=0;bool ok=WriteFile(file,data.data(),DWORD(data.size()),&wrote,0)&&wrote==data.size()&&FlushFileBuffers(file);CloseHandle(file);if(!ok)throw std::runtime_error("Could not save the complete downloaded update");return package;}
static void updateInstall(HWND window,const situpdate::Manifest&m,const UpdatePackage&p){auto target=updateEnv(L"SIT_LAUNCHER_PATH"),helper=updateEnv(L"SIT_UPDATE_HELPER");auto name=m.download.substr(m.download.find_last_of('/')+1);name.replace(name.size()-4,4,".exe");auto params=updateQuote(target)+L" "+updateQuote(p.path)+L" "+updateQuote(wide(m.sha256))+L" "+updateQuote(wide(m.release))+L" "+updateQuote(wide(name))+L" "+updateQuote(wide(p.oldHash))+L" "+updateEnv(L"SIT_LAUNCHER_PID")+L" "+wide(std::to_string(GetCurrentProcessId()))+L" "+wide(std::to_string(reinterpret_cast<uintptr_t>(GetWindow(window,GW_OWNER))));STARTUPINFOW inherited={sizeof(inherited)};GetStartupInfoW(&inherited);STARTUPINFOW si={sizeof(si)};si.lpDesktop=inherited.lpDesktop;si.dwFlags=STARTF_USESHOWWINDOW;si.wShowWindow=SW_HIDE;PROCESS_INFORMATION pi={};auto cmd=updateQuote(helper)+L" "+params;std::vector<wchar_t>writable(cmd.begin(),cmd.end());writable.push_back(0);if(!CreateProcessW(helper.c_str(),writable.data(),0,0,FALSE,0,0,0,&si,&pi))throw std::runtime_error("Cannot start the update installer. Your current program has not been changed.");CloseHandle(pi.hThread);CloseHandle(pi.hProcess);}
